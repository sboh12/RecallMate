<Window x:Class="RecallMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RecallMate.ViewModels"
        Title="RecallMate" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Height="25" VerticalContentAlignment="Center"
                     ToolTip="Search your memory... e.g. 'sprint planning notes last Monday'">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Search" Command="{Binding SearchCommand}"
                    Margin="5,0,0,0" Width="80"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Margin="5,0,0,0" Width="80"/>
            <Button Command="{Binding ToggleCaptureCommand}"
                    Margin="15,0,0,0" Width="110">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="⏸ Pause Capture"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapturing}" Value="False">
                                <Setter Property="Content" Value="▶ Resume Capture"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Timeline List -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Timeline}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Expander Header="{Binding DateHeader}" IsExpanded="True" Margin="0,5">
                        <ItemsControl ItemsSource="{Binding Snapshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding WindowTitle}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="Gray"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                       FontSize="11" Foreground="DarkGray"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
