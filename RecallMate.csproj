<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>false</PublishAot> <!-- set true for final low-mem build -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <!-- Note: UIAutomationClient/UIAutomationTypes (used by BrowserUrlHelper.cs)
       don't need an explicit <Reference> - UseWPF=true already pulls them in.
       Adding them explicitly causes an MSB3243 assembly-version conflict. -->

</Project>
